# Supabase (Project Settings -> API)
# URL looks like https://xxxxxxxx.supabase.co  (no trailing slash, no /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
# The service_role key (NOT the anon key). Server-side only — never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets two-way sync (leave blank to run with sync_state='skipped'/'failed' but no request ever lost)
# Base64-encode the full service-account JSON key file:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=
# The "Guest Post Anchor" team spreadsheet ID (from its URL). Every project shares this one sheet.
TEAM_SHEET_ID=
# Shared secret the Apps Script's installable trigger sends back on every sheet edit
SHEET_WEBHOOK_SECRET=
