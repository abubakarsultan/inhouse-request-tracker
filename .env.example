# Supabase (server-side service-role access only; there is no login/auth flow)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets mirror
# Base64-encoded full service-account JSON key. Share the team sheet with
# the service account as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
TEAM_SHEET_ID=

# Used by the sheet -> site webhook (completed/refined in Phase 4).
SHEET_WEBHOOK_SECRET=
