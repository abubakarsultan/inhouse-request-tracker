# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key used only for Supabase Auth sessions. Starts with sb_publishable_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret/service-role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated @rankviz.com addresses that should be admins.
# Example: abubakar@rankviz.com,manager@rankviz.com
ADMIN_EMAILS=

# Google Sheets mirror
# Base64-encoded full service-account JSON key. Share the team sheet with
# the service account as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
TEAM_SHEET_ID=

# Used by the installable team-sheet edit trigger -> site webhook.
SHEET_WEBHOOK_SECRET=
