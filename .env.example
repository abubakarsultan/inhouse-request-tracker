# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key used only for Supabase Auth sessions. Starts with sb_publishable_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret/service-role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated @rankviz.com addresses that should be admins.
# Example: abubakar@rankviz.com,manager@rankviz.com
ADMIN_EMAILS=

# Google Sheets mirror
# Base64-encoded full service-account JSON key. Share the team sheet with
# the service account as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
TEAM_SHEET_ID=

# Used by the installable team-sheet edit trigger -> site webhook.
SHEET_WEBHOOK_SECRET=

# Per-user Google Drive OAuth (server-only; never use a shared refresh token)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Public site origin used to build the OAuth callback URL, e.g. https://inhouse.example.com
NEXT_PUBLIC_SITE_URL=

# V9 daily operations checks. Server-only secret used by Vercel Cron to authorize
# /api/cron/operations. Generate a new random value with openssl rand -hex 32.
# Configure on Vercel Production; do not reuse an OAuth token or sheet webhook secret.
CRON_SECRET=
