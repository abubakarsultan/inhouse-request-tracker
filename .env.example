# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The single account allowed to sign in to this app
ADMIN_EMAIL=abubakarsultan@rankviz.com

# Only used once, by app/api/admin/seed/route.ts, to create/reset the
# account above. Set this in Vercel, hit the route once, then remove
# both ADMIN_PASSWORD and SETUP_SECRET (or delete the route file).
ADMIN_PASSWORD=
SETUP_SECRET=

# Google Sheets two-way sync (optional — leave blank to run without sync)
# Base64-encode the full service-account JSON key file:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=
# Shared secret the Apps Script sends back on every sheet edit
SHEET_WEBHOOK_SECRET=
